# Copy to .env and edit. `.env` is gitignored and never committed.
#
# An exported variable always wins over this file, so `FAL_MODE=off npm run …`
# still holds. Read by `next dev`, `next start`, `npx openflow-studio` and
# `npm run run`; the test suites set their own modes and ignore it entirely.

# ---- rendering ----------------------------------------------------------

# Your fal.ai key: https://fal.ai/dashboard/keys
# You pay fal directly, at cost. Not needed to open the canvas — only to render.
FAL_KEY=

# live   — real fal calls, real money. The default.
# replay — serve recorded fixtures from test/fixtures/fal. No key, no spend.
# stub   — synthesise a placeholder for any request.
# off    — throw on any dispatch.
# FAL_MODE=live

# ---- brief to flow (optional) -------------------------------------------

# Only for the Brief panel. The canvas works fully without it; with no key the
# LLM seam defaults to `off` rather than failing at a different moment.
ANTHROPIC_API_KEY=

# live | replay | off. Defaults to `live` when the key above is set.
# LLM_MODE=off

# ---- where things live --------------------------------------------------

# The SQLite file and generated assets. Point this away from ./data before
# experimenting — a shared database between two processes destroys paid-for work.
# OPENFLOW_DATA_DIR=./data

# Exported deliverables.
# OPENFLOW_EXPORTS_DIR=./exports

# Read-only public demo: forces replay, pre-bakes the demo flow, refuses every
# render request. This is the mode a hosted demo runs in.
# DEMO=1

# The port `npx openflow-studio` serves on.
# PORT=3000
