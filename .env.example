# Copy to .env and edit. `.env` is gitignored and never committed.
#
# An exported variable always wins over this file, so `FAL_MODE=off npm run …`
# still holds. Read by `next dev`, `next start`, `npm run studio` and
# `npm run run`; the test suites set their own modes and ignore it entirely.

# ---- rendering ----------------------------------------------------------

# Your fal.ai key: https://fal.ai/dashboard/keys
# You pay fal directly, at cost. Not needed to open the canvas — only to render.
FAL_KEY=

# live   — real fal calls, real money. The default.
# replay — serve recorded fixtures from test/fixtures/fal. No key, no spend.
# stub   — synthesise a placeholder for any request.
# off    — throw on any dispatch.
# FAL_MODE=live

# ---- brief to flow (optional) -------------------------------------------

# The chat agent. Without it LLM_MODE falls back to `off` and chat is disabled.
OPENROUTER_API_KEY=
# One line to change the model. Anything on OpenRouter that supports tool use.
OPENROUTER_MODEL=anthropic/claude-opus-5

# live | replay | off. Defaults to `live` when the key above is set.
# LLM_MODE=off

# ---- asset hosting (optional) -------------------------------------------

# Unset, everything stays on this machine and references are base64'd into the
# fal request — fine for stills, refused above 12 MB. Set, uploads and rendered
# frames are also pushed to Cloudinary and fal is given a URL to fetch, which is
# what makes a large video reference workable. Local copies are kept either way,
# because ffmpeg and sharp read files, not URLs.
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# ---- which models you can pick ------------------------------------------

# Not a variable. The model catalog is `models.json` in the data dir below,
# seeded on first boot from the rows that ship.
#
# To add more: put fal model ids in `models.txt` beside it, one per line, and
# run `npm run models:add`. Capabilities and price are read from fal; ids you
# already have are skipped. Editing models.json by hand does the same job.

# ---- where things live --------------------------------------------------

# The SQLite file and generated assets. Point this away from ./data before
# experimenting — a shared database between two processes destroys paid-for work.
# OPENFLOW_DATA_DIR=./data

# Exported deliverables.
# OPENFLOW_EXPORTS_DIR=./exports

# Read-only public demo: forces replay, pre-bakes the demo flow, refuses every
# render request. This is the mode a hosted demo runs in.
# DEMO=1

# The port `npm run studio` serves on.
# PORT=3000
